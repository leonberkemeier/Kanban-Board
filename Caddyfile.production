kanban.leonberkemeier.de {
    # Enable compression for better performance
    #encode gzip
    
    # Security headers
    #header {
    #    X-Content-Type-Options nosniff
    #    X-Frame-Options DENY
    #    X-XSS-Protection "1; mode=block"
    #    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    #}
    
    # Handle API requests - proxy to Django backend at localhost:9000
    # This matches REACT_APP_API_URL=https://kanban.leonberkemeier.de/api
    handle /api/* {
        reverse_proxy localhost:9000
    }
    
    # Handle all other requests - serve React frontend
    handle {
        root * /var/www/kanban
        try_files {path} /index.html
        file_server
    }
    
    # Logs
    log {
        output file /var/log/caddy/kanban.log
        format console
    }
}
